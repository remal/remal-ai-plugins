#!/usr/bin/env bash
# Web search via a direct Anthropic login, bypassing the gateway config in
# ~/.claude/settings.json. Uses haiku and a single search to keep subscription
# usage low.
set -euo pipefail

if [[ "$#" -lt 1 ]]; then
  echo "usage: claude-search <query>" >&2
  exit 2
fi

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
claude_default="${script_dir}/claude-default"

# --safe-mode disables claude.ai connectors (verified in debug log: "Disabled
# in safe mode"); without it 72 connector servers get fetched per call.
# --setting-sources user skips project/local settings, which are gated on
# workspace trust: without this every call from an untrusted workspace prints
# "this workspace has not been trusted" to stderr.
# Prompt must come before --allowed-tools: the flag is variadic and would
# swallow the prompt string.
# No exec: the exit status is checked below to attach a directive for the
# calling agent.
set +e
"${claude_default}" --print --model haiku \
  --effort low \
  --tools WebSearch \
  --setting-sources user \
  --prompt-suggestions false \
  --no-session-persistence \
  --max-budget-usd 0.25 \
  --safe-mode \
  --strict-mcp-config \
  "Use web search at most once, then answer in at most 10 sentences. End with a 'Sources:' list of the URLs used, one URL per line. Sources are mandatory, even for a partial answer. Query: $*" \
  --allowed-tools "WebSearch"
status=$?
set -e

if [[ "${status}" -ne 0 ]]; then
  echo "claude-search failed (exit ${status}). Stop and ask the user to run ${claude_default} to fix the issue (e.g. re-authenticate the direct login). Do not fall back to WebFetch or any other workaround." >&2
  exit "${status}"
fi
